#!/bin/sh
# Lint and the unittest suite; the C++ host tests compile against mocks with the stock c++.
# Not here: the N64Recomp oracle build, which needs the ROM and the rig.
# The dev tools come from this repository's own [dev] extra, never from PATH or a deploy: a private venv under the
# git-ignored .venv/, keyed by pyproject.toml and every installed source revision.
set -eu
cd "$(dirname "$0")/.."
ci/abucache-audit
py="$(python3 ci/ensure_venv.py)"
python3 ci/ensure_venv.py unbake >/dev/null  # tests/test_unbake_pin.py reads the unbake that ci/oracle runs
"$py" -m ruff check src tests ci/ensure_venv.py
"$py" -m unittest discover -s tests
