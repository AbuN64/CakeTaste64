#!/bin/sh
# ci/oracle build | selfcheck [HOST]: the N64Recomp oracle (n64host) of this tree, built and self-checked. Every path
# is found from the repository itself, no environment input:
#   ../RageWarsDecomp   the decomp working copy beside this repository (roms/ holds the cartridge dumps; its git history
#                       holds the PINS RageWars commit the oracle is recompiled from)
#   .state/             this repository's git-ignored state: oracle-deps/ (N64Recomp, N64ModernRuntime, rt64, fetched at
#                       their PINS by deps.sh), oracle/<sha>/ (the build), oracle/live (link to the self-checked build),
#                       tools/abumas (built from the AbuMas PINS commit), unbake.toml (this tree's own unbake host config,
#                       written from unbake's template by host_config.py; the operator file is never read),
#                       oracle-facts.json (derived by the build), cfg/ (host config dir)
#   hosts/n64recomp/ragewars.profile.json   the tracked RageWars project profile the recompile derives from
#   .venv/              the declared toolchain (pyproject.toml: abucache, unbake), made by ci/ensure_venv.py
# Heavy: run it through `mo-terminal Admission Invoke --Class Batch`. Exit 0 only for a built and self-checked oracle.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
state=$root/.state
decomp=$root/../RageWarsDecomp
version=us-rev1
rom=$decomp/roms/baserom.$version.z64
profile=$root/hosts/n64recomp/ragewars.profile.json
facts=$state/oracle-facts.json
cfg=$state/cfg
host=$state/unbake.toml
link=$state/oracle/live
timed() {  # NAME COMMAND...: the command, then its wall seconds on stderr
  name=$1
  shift
  t0=$(date +%s)
  "$@"
  echo "oracle-time: $name $(( $(date +%s) - t0 ))s" >&2
}

selfcheck() {  # HOST: boot-idle twice; the two state hashes must be equal
  host=$1
  addrs=$(dirname "$host")/gen/symbol_addrs.txt
  for need in "$host" "$addrs" "$rom"; do
    test -e "$need" || { echo "selfcheck: $need is missing" >&2; exit 1; }
  done
  work=$(mktemp -d)
  spec=$work/oracle.spec
  sed -En -e '1i ram 800000\nregion ALL' -e 's/^(\S+) = 0x(80[0-7][0-9A-Fa-f]{4}[048cC]);.*/symbol \1\nrun \2 w 1/p' "$addrs" > "$spec"
  grep -q ^symbol "$spec" || { echo "selfcheck: $addrs has no RDRAM symbol" >&2; exit 1; }
  movie=$work/movie.raw
  yes '0000 0 0' | head -n 600 > "$movie"
  mkdir -p "$cfg"
  first=
  for n in 1 2; do
    out=$work/$n
    mkdir "$out"
    (
      cd "$out"
      export SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy N64R_ROM=$rom N64R_CONFIG=$cfg VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json N64R_PAK=on N64R_PADS=1 N64R_TAS_PLAY=$movie N64R_TAS_EXIT_AFTER=300 N64R_VIEW=$out/view.bmp N64R_AUDIO_OUT=/dev/null N64R_TAS_SHOT_EVERY=0 N64R_TAS_TRACE=$out/oracle-trace.txt N64R_TAS_STATE=$spec N64R_TAS_STATE_HASH=$out/state-oracle.txt
      unset N64R_CPAK
      "$host" > oracle.txt 2>&1 || { rc=$?; tail -n 5 oracle.txt >&2; echo "boot-idle run $n exit $rc" >&2; exit 1; }
    ) || exit 1
    hash=$(sha256sum "$out/state-oracle.txt" | cut -c1-16)
    echo "readback-hash: $hash"
    test -z "$first" || test "$first" = "$hash" || { echo "boot-idle state hashes differ: $first $hash" >&2; exit 1; }
    first=$hash
  done
  rm -rf "$work"
}

build() {
  test -d "$decomp/.git" || { echo "oracle: the decomp working copy $decomp is missing; clone RageWarsDecomp beside this repository" >&2; exit 1; }
  test -e "$rom" || { echo "oracle: $rom is missing (the decomp's roms/ holds the dumps)" >&2; exit 1; }
  sha=$(git rev-parse HEAD)
  jobs=$(nproc)
  py=$(python3 ci/ensure_venv.py)
  unbake=$(dirname "$py")/unbake
  test -x "$unbake" || { echo "oracle: $unbake is missing; pyproject.toml declares unbake in [dev], rebuild .venv" >&2; exit 1; }
  build=$state/oracle/$sha
  if [ -x "$build/n64host" ] && [ "$(readlink -f "$link")" = "$(readlink -f "$build")" ]; then
    echo "oracle: $build is live already, build skipped"
    exit 0
  fi
  mkdir -p "$state/oracle" "$state/oracle-deps"
  rm -rf "$build"
  mkdir "$build"
  trap 'rc=$?; test "$rc" = 0 || rm -rf "$build"' EXIT
  timed deps sh hosts/n64recomp/deps.sh "$state/oracle-deps"
  mkdir -p "$state/tools"
  timed abumas make -C "$state/oracle-deps/AbuMas" -j"$jobs"
  install -m 755 "$state/oracle-deps/AbuMas/build/abumas" "$state/tools/abumas"
  "$py" hosts/n64recomp/host_config.py "$host" "$state" --abumas "$state/tools/abumas"
  mkdir "$build/deps"
  cp -a "$state/oracle-deps/N64ModernRuntime" "$state/oracle-deps/rt64" "$state/oracle-deps/N64Recomp" "$build/deps/"
  rm -rf "$build/deps/N64Recomp/build"
  timed recompile sh hosts/n64recomp/recompile.sh "$build" "$root" "$decomp" "$profile" "$version" "$py" "$unbake" "$host" "$jobs"
  gen=$build/recomp/$version
  PYTHONPATH=$root/src "$py" -m cake_taste --profile "$build/taste-profile.json" recomp facts --version "$version" --output "$facts"
  cmake -S hosts/n64recomp -B "$build/build" -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=/usr/bin/gcc-14 -DCMAKE_CXX_COMPILER=/usr/bin/g++-14 \
    -DN64R_GEN_DIR="$gen" -DN64R_PINS="$root/hosts/n64recomp/PINS" -DN64R_PROFILE="$facts" \
    -DN64R_REFUSED="$gen/refused.tsv" \
    -DN64R_RT64_SRC="$build/deps/rt64" -DN64R_RUNTIME_SRC="$build/deps/N64ModernRuntime" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
  timed host-build cmake --build "$build/build" -j"$jobs"
  install -m 755 "$build/build/n64host" "$build/n64host"
  mkdir "$build/gen"
  install -m 644 "$build/build/gen/cpu_profile.h" "$build/build/gen/cpu_native.h" "$gen/symbols.toml" "$build/gen/"
  install -m 644 "$build/decomp/versions/$version/symbol_addrs.txt" "$build/gen/"
  "$py" - "$sha" "$build/gen" "$facts" "$(git -C "$build/decomp" rev-parse HEAD)" > "$build/oracle-pins.json" <<'PY'
import hashlib, json, pathlib, sys, time
gen = {n: hashlib.sha256((pathlib.Path(sys.argv[2]) / n).read_bytes()).hexdigest() for n in ("cpu_profile.h", "cpu_native.h")}
decomp = {"commit": sys.argv[4],
          "symbol_addrs": hashlib.sha256((pathlib.Path(sys.argv[2]) / "symbol_addrs.txt").read_bytes()).hexdigest()}
print(json.dumps({"cake_taste": sys.argv[1], "built_at": time.strftime("%Y-%m-%dT%H:%M:%S"), "gen": gen,
                  "decomp": decomp, "facts": hashlib.sha256(pathlib.Path(sys.argv[3]).read_bytes()).hexdigest()}, indent=1))
PY
  rm -rf "$build/deps" "$build/build" "$build/decomp" "$build/recomp" "$build/taste-run"
  timed selfcheck selfcheck "$build/n64host"
  ln -sfn "$build" "$link.new"
  mv -T "$link.new" "$link"
  echo "oracle: $build live"
}

case ${1:-} in
  build) build ;;
  selfcheck) selfcheck "${2:-$link/n64host}" ;;
  *) echo "usage: ci/oracle build | selfcheck [HOST]" >&2; exit 2 ;;
esac
