+std::vector<std::string> get_runtime_funcs(const toml::table* patches_data) {
+    std::vector<std::string> runtime_funcs{};
+
+    // Check if the runtime funcs array exists.
+    const toml::node_view runtime_funcs_data = (*patches_data)["runtime"];
+
+    if (runtime_funcs_data.is_array()) {
+        const toml::array* runtime_funcs_array = runtime_funcs_data.as_array();
+
+        // Make room for all the runtime funcs in the array.
+        runtime_funcs.reserve(runtime_funcs_array->size());
+
+        // Gather the runtime and place them into the array.
+        runtime_funcs_array->for_each([&runtime_funcs](auto&& el) {
+            if constexpr (toml::is_string<decltype(el)>) {
+                runtime_funcs.push_back(*el);
+            }
+        });
+    }
+
+    return runtime_funcs;
+}
